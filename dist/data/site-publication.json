    {
      "id": "playbook-bounded-parallel-implementation",
      "name": "Bounded parallel implementation",
      "status": "Working model",
      "summary": "Produce a small set of independent, reviewable implementation results—normally one branch and one pull request per workstream—after each workstream is source-grounded against current target-repository truth, with compact handoffs, independent review against current repository state, scoped correction only when needed, and merge only after authorization under the target repository's pinned GitHub Tool contract.",
      "kind": "process",
      "source": "docs/playbooks/bounded-parallel-implementation.md",
      "sourceHref": "https://github.com/rickvang/Persona-Library/blob/main/docs/playbooks/bounded-parallel-implementation.md",
      "sourceSha256": "337d6755c48f6234fdcee419f2a8ce08005fd3896afa9e747235ed73a499118e",
      "href": "playbook-bounded-parallel-implementation.html",
      "legacyAnchor": "bounded-parallel",
      "outline": [
        "0. Orientation preflight",
        "1. Ground candidate workstreams in target-repository source",
        "2. Bound and dispatch",
        "3. Implement in parallel",
        "4. Compact handoff",
        "5. Independent review",
        "6. Scoped correction",
        "7. Authorized merge and stop"
      ],
      "outlineHeading": "Stages",
      "outlineLabel": "stages",
      "roles": [
        "Coordinator",
        "Implementer",
        "Reviewer",
        "Authorizer"
      ],
      "operator": null
    },
    {
      "id": "playbook-template-lifecycle",
      "name": "Research, promote, and maintain a reusable Template",
      "status": "Working model",
      "summary": "Move a reusable Template need from discovery through reuse-or-create, specialist quality when required, validation, promotion-or-local decision, Persona-Library catalog/Site publication, and reconciliation—without confusing library stewardship with domain authorship or copying external starters into Persona-Library.",
      "kind": "process",
      "source": "docs/playbooks/template-lifecycle.md",
      "sourceHref": "https://github.com/rickvang/Persona-Library/blob/main/docs/playbooks/template-lifecycle.md",
      "sourceSha256": "6df76bca5757ab9d97375555b9c49a394da1e6e2b10d523f6f47e6a23ae50dc6",
      "href": "playbook-template-lifecycle.html",
      "legacyAnchor": "template-lifecycle",
      "outline": [
        "01 / DEFINE — Scope the Template need",
        "02 / DISCOVER — Search catalog and verify sources",
        "03 / ROUTE — Hand off domain quality when needed",
        "04 / COMPOSE — Create or adapt the smallest starter",
        "05 / VALIDATE — Prove source, boundary, and quality",
        "06 / LIFECYCLE — Keep local, publish, promote, update, or deprecate",
        "07 / RECONCILE — Review downstream effects once"
      ],
      "outlineHeading": "Stages",
      "outlineLabel": "stages",
      "roles": [],
      "operator": {
        "id": "template-librarian",
        "name": "Elena Park",
        "roleLabel": "Template Librarian"
      }
    }
  ],
